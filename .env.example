EXPO_PUBLIC_API_BASE_URL=http://<LAN-IP>:8000

# 5-1 카카오 웹 지도 증명용(기본 꺼짐). 키는 .env.local에만 둔다.
# EXPO_PUBLIC_WALK_MAP_KAKAO_WEB=true
# EXPO_PUBLIC_KAKAO_JS_KEY=<JavaScript 키>
# EXPO_PUBLIC_KAKAO_WEB_BASE_URL=http://localhost:5173

# 개발용 가짜 GPS(기본 꺼짐). __DEV__일 때만 동작해서 프로덕션 빌드에서는 켜져 있어도 무시된다.
# 켜면 5-1 위쪽에 "가짜 GPS 사용 중 (개발용)" 배너가 보이고, 실제 위치 권한은 묻지 않는다. 바꾼 뒤 npx expo start -c로 다시 시작한다.
# EXPO_PUBLIC_DEV_FAKE_GPS=true
# 경로 끊김 시험: 1분마다 20초 동안 표본 없음 / 가끔 정확도 30m 표본
# EXPO_PUBLIC_DEV_FAKE_GPS_GAP=true
# EXPO_PUBLIC_DEV_FAKE_GPS_BAD_ACCURACY=true
